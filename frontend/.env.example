# Optional HTTPS overrides. Copy to .env.https.local only when using custom paths.
# Paths are relative to frontend, or absolute. Keep certificates/keys outside public.
# These are server-only settings. Never use a VITE_ prefix for private key settings.
DEV_HTTPS_CERT=dev-https.local.pem
DEV_HTTPS_KEY=dev-https-key.local.pem
